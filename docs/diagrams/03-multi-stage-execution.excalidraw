    {
      "type": "text",
      "id": "query_text",
      "x": 40,
      "y": 72,
      "width": 330,
      "height": 86,
      "text": "SELECT o.order_id, c.name,\n       SUM(l.qty) AS total_qty\nFROM orders o\n  JOIN customers c ON o.cust_id = c.cust_id\n  JOIN lineitems l ON o.order_id = l.order_id\nGROUP BY o.order_id, c.name\nORDER BY total_qty DESC LIMIT 10",
      "originalText": "SELECT o.order_id, c.name,\n       SUM(l.qty) AS total_qty\nFROM orders o\n  JOIN customers c ON o.cust_id = c.cust_id\n  JOIN lineitems l ON o.order_id = l.order_id\nGROUP BY o.order_id, c.name\nORDER BY total_qty DESC LIMIT 10",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 10012,
