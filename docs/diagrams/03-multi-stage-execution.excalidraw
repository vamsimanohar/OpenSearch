    {
      "type": "text",
      "id": "stage3_text",
      "x": 310,
      "y": 385,
      "width": 240,
      "height": 100,
      "text": "Stage 3: HASH JOIN + FINAL AGG\n\nSELECT order_id, name,\n  SUM(partial_sum) AS total_qty\nFROM shuffle_input_0 s1\nJOIN shuffle_input_1 s2\n  ON s1.order_id = s2.order_id\nGROUP BY order_id, name",
      "originalText": "Stage 3: HASH JOIN + FINAL AGG\n\nSELECT order_id, name,\n  SUM(partial_sum) AS total_qty\nFROM shuffle_input_0 s1\nJOIN shuffle_input_1 s2\n  ON s1.order_id = s2.order_id\nGROUP BY order_id, name",
      "fontSize": 10,
