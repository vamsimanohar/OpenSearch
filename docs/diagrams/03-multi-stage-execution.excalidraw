    {
      "type": "text",
      "id": "stage1_text",
      "x": 310,
      "y": 230,
      "width": 240,
      "height": 90,
      "text": "Stage 1: BROADCAST JOIN\n+ SCAN orders + PARTIAL AGG\n\nSELECT o.order_id, c.name,\n  SUM(l.qty) AS partial_sum\nFROM orders o\nJOIN shuffle_input_0 c ON ...\nGROUP BY o.order_id, c.name",
      "originalText": "Stage 1: BROADCAST JOIN\n+ SCAN orders + PARTIAL AGG\n\nSELECT o.order_id, c.name,\n  SUM(l.qty) AS partial_sum\nFROM orders o\nJOIN shuffle_input_0 c ON ...\nGROUP BY o.order_id, c.name",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
