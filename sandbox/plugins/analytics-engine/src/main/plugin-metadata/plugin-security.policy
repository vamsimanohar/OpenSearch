grant {
  // Cross-plugin calls: when child plugins (e.g., lakehouse-iceberg) connect
  // to external services (AWS S3/Glue/STS), this plugin's classes appear in
  // the call stack due to shared classloader delegation. The security manager
  // checks ALL frames, so this plugin must also grant socket access.
  permission java.net.SocketPermission "*", "connect,resolve";
};
