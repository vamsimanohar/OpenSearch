grant {
  // AWS SDK + Iceberg need broad permissions for:
  // - Reading ~/.aws/credentials and ~/.aws/config
  // - Socket connections to Glue and S3 endpoints
  // - Reflection for AWS SDK client construction
  // - System property reads for region/credentials
  permission java.security.AllPermission;
};
